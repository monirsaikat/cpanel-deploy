    "cli",
    "laravel",
    "php"
  ],
  "author": "Moniruzzaman Saikat",
  "license": "MIT",
  "homepage": "https://saikat.polapain.net/cpanel-deploy",
  "scripts": {
    "start": "node bin/cpanel-deploy.js",
    "test": "node --test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
